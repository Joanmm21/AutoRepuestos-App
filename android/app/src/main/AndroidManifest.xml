<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Autorepuestos"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Pantalla de Login (Se abre primero al iniciar la app) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla de Registro -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false" />

        <!-- Pantalla Principal  -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".DetalleProductoActivity"
            android:exported="false" />
        <activity
            android:name=".CarritoActivity"
            android:exported="false" />
        <activity
            android:name=".HistorialPedidosActivity"
            android:exported="false" />
        <activity
            android:name=".AdminActivity"
            android:exported="false" />
        <activity
            android:name=".AdminCatalogoActivity"
            android:exported="false" />

        <activity
            android:name=".AdminProductoFormActivity"
            android:exported="false" />

        <activity
            android:name=".AdminPedidosActivity"
            android:exported="false" />
    </application>

</manifest>