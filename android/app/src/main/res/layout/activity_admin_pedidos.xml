<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#101114"
    android:padding="16dp">

    <Button
        android:id="@+id/btnVolverPedidosAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="← Volver al panel"
        android:textColor="#FFFFFF"
        android:backgroundTint="#292A30" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Gestión de pedidos"
        android:textColor="#FFFFFF"
        android:textSize="23sp"
        android:textStyle="bold"
        android:background="#B00000"
        android:padding="12dp" />

    <TextView
        android:id="@+id/tvEstadoPedidosAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cargando..."
        android:textColor="#BBBBBB"
        android:padding="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/listaPedidosAdmin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </ScrollView>

</LinearLayout>